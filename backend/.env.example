# Copy to .env and fill in for a real provider. Defaults (mock/mock) run
# fully offline with no API keys -- useful for wiring/pipeline verification,
# not for judging actual answer quality.

LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Gemini
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# Vector store
CHROMA_PERSIST_DIR=./data/chroma
CHROMA_COLLECTION=kb_documents

# Ingestion / retrieval tuning
CHUNK_SIZE_TOKENS=700
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=5

# Auth (non-production RBAC demo users)
JWT_SECRET=change-me-in-real-deployment
DEMO_VIEWER_USERNAME=viewer
DEMO_VIEWER_PASSWORD=viewer123
DEMO_AUTHOR_USERNAME=author
DEMO_AUTHOR_PASSWORD=author123
