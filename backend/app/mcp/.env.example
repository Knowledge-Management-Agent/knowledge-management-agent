# Config for running the local MCP server (python -m app.mcp.server).
# This process is a REST client -- point it at wherever the KM API is
# actually running: http://localhost:8000 for local Compose, or the
# cluster's Ingress URL once deployed to EKS (see ../../../step.md).
KM_API_BASE_URL=http://localhost:8000

# Either a username/password for a demo viewer/author user (the MCP
# server logs in and caches the JWT, re-logging in on expiry)...
KM_MCP_USERNAME=author
KM_MCP_PASSWORD=author123

# ...or a pre-issued bearer token instead of username/password.
KM_MCP_TOKEN=

KM_MCP_TIMEOUT_SECONDS=30
